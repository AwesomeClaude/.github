{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game readme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_url",
    "title",
    "source_analysis",
    "screenshots",
    "reconstructed_prompt",
    "how_to_play",
    "mechanics",
    "tags",
    "rating",
    "reviews",
    "links",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "basis",
          "sources"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "basis": {
            "enum": [
              "observed",
              "inferred",
              "planned"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "viewed",
          "findings"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
          },
          "viewed": {
            "type": "boolean"
          },
          "findings": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0
    },
    "reconstructed_prompt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "how_to_play": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "basis",
          "sources"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "basis": {
            "enum": [
              "observed",
              "inferred",
              "planned"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "rationale"
      ],
      "properties": {
        "grade": {
          "enum": [
            "A",
            "AA",
            "AAA"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fictional",
          "rating",
          "text"
        ],
        "properties": {
          "fictional": {
            "const": true
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  }
}
