{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/game-analysis.schema.json",
  "title": "Game Analysis Report",
  "description": "Reusable schema for analyzing a game's public source, screenshots, mechanics, publication status, ratings, reviews, and links.",
  "type": "object",
  "required": [
    "report_metadata",
    "publication_and_modification",
    "identity",
    "source_analysis",
    "external_services_and_runtime",
    "screenshot_analysis",
    "reverse_engineered_prompt",
    "how_to_play",
    "mechanics",
    "tags",
    "rating",
    "generated_user_reviews",
    "collected_links",
    "bottom_line"
  ],
  "additionalProperties": false,
  "properties": {
    "report_metadata": {
      "$ref": "#/$defs/reportMetadata"
    },
    "publication_and_modification": {
      "$ref": "#/$defs/publication"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "source_analysis": {
      "$ref": "#/$defs/sourceAnalysis"
    },
    "screenshot_analysis": {
      "$ref": "#/$defs/screenshotAnalysis"
    },
    "reverse_engineered_prompt": {
      "type": "string"
    },
    "how_to_play": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mechanics": {
      "type": "object",
      "required": [
        "combat",
        "meta_and_narrative"
      ],
      "additionalProperties": false,
      "properties": {
        "combat": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta_and_narrative": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planned_or_specified_minigames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rating": {
      "$ref": "#/$defs/rating"
    },
    "generated_user_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      },
      "minItems": 3
    },
    "collected_links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "bottom_line": {
      "type": "string"
    },
    "external_services_and_runtime": {
      "type": "object",
      "required": [
        "operating_model",
        "requires_external_services",
        "requires_api",
        "requires_server",
        "requires_network_connection",
        "static_assets_and_local_logic",
        "local_dependencies",
        "observed_network_integrations",
        "observed_backend_integrations",
        "offline_features"
      ],
      "additionalProperties": false,
      "properties": {
        "operating_model": {
          "type": "string"
        },
        "requires_external_services": {
          "type": "boolean"
        },
        "requires_api": {
          "type": "boolean"
        },
        "requires_server": {
          "type": "boolean"
        },
        "requires_network_connection": {
          "type": "boolean"
        },
        "static_assets_and_local_logic": {
          "type": "boolean"
        },
        "local_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_network_integrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_backend_integrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "development_only_dependency": {
          "type": "string"
        },
        "offline_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "$defs": {
    "reportMetadata": {
      "type": "object",
      "required": [
        "report_title",
        "reviewed_date",
        "method",
        "repository_url"
      ],
      "additionalProperties": false,
      "properties": {
        "report_title": {
          "type": "string"
        },
        "reviewed_date": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "public_game_release_date",
        "public_game_release_status",
        "repository_created_date",
        "latest_push_date",
        "latest_metadata_update_date",
        "source_url"
      ],
      "additionalProperties": false,
      "properties": {
        "public_game_release_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "public_game_release_status": {
          "type": "string"
        },
        "repository_created_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "latest_push_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "latest_metadata_update_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "repository_name",
        "game_title",
        "genre",
        "current_status"
      ],
      "additionalProperties": false,
      "properties": {
        "repository_name": {
          "type": "string"
        },
        "game_title": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "platform_target": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "genre": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setting": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        },
        "current_status": {
          "type": "string"
        }
      }
    },
    "sourceAnalysis": {
      "type": "object",
      "required": [
        "architecture",
        "verification",
        "key_links"
      ],
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_links": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "screenshotAnalysis": {
      "type": "object",
      "required": [
        "screenshots"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_folder": {
          "type": "string",
          "format": "uri"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/screenshot"
          }
        }
      }
    },
    "screenshot": {
      "type": "object",
      "required": [
        "name",
        "url",
        "observations",
        "strengths",
        "risks"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rating": {
      "type": "object",
      "required": [
        "scale",
        "overall",
        "reason",
        "subscores"
      ],
      "additionalProperties": false,
      "properties": {
        "scale": {
          "const": "A to AAA"
        },
        "overall": {
          "type": "string",
          "pattern": "^(A|AA|AAA)([+-])?$|^A/AA$"
        },
        "reason": {
          "type": "string"
        },
        "subscores": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "rating",
        "review"
      ],
      "additionalProperties": false,
      "properties": {
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "review": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
